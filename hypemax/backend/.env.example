# =====================================================================================
# HYPEMAX Nutrition: environment variable TEMPLATE. Contains NO real values.
#
# Production (Hostinger): enter these in hPanel -> your Node.js app -> Environment variables.
# Local development: copy this file to backend/.env (git-ignored) and fill it in yourself.
# Never commit a real .env, never paste secrets into chats, tickets or screenshots.
# If a value contains # or spaces and you use a .env file, wrap it in double quotes.
# Full instructions: API_CONFIGURATION_GUIDE.md
# =====================================================================================

# ---------- Server ----------
NODE_ENV=production
PORT=4000
# Public URL, https, no trailing slash. Used for emails, OAuth callback, sitemap and the CSRF origin check.
SITE_URL=https://www.your-domain.in
COOKIE_SECURE=true

# ---------- MySQL (hPanel -> Databases -> MySQL Databases) ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=false
DB_POOL=10

# ---------- First Super Admin (created on first start only if no admin exists; remove the password afterwards) ----------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Super Admin

# ---------- Razorpay (Dashboard -> Account & Settings -> API Keys). Start with rzp_test_ keys. ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you type when creating the webhook for https://YOUR-DOMAIN/api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=
# Minutes an unpaid order holds stock and coupon before being released
ORDER_RESERVATION_MINUTES=30

# ---------- Cloudinary (Console -> Dashboard -> Product Environment Credentials) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=hypemax

# ---------- Google sign-in (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client, type Web) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be registered exactly as an Authorised redirect URI in Google Cloud
GOOGLE_CALLBACK_URL=https://www.your-domain.in/api/auth/google/callback

# ---------- Email via SMTP (Hostinger Email: smtp.hostinger.com, 465, SSL) ----------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="HYPEMAX Nutrition <no-reply@your-domain.in>"
# Where new-order and contact-form alerts go (comma-separated). Defaults to the store email in Site settings.
ADMIN_NOTIFY_EMAIL=
# Require customers to verify their email before logging in (only enforced when SMTP is configured)
REQUIRE_EMAIL_VERIFICATION=false

# ---------- Sessions ----------
SESSION_DAYS=14
ADMIN_SESSION_HOURS=12
